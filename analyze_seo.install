<?php

declare(strict_types=1);

/**
 * @file
 * Install, update, and uninstall functions for the Analyze SEO module.
 */

/**
 * Implements hook_schema().
 *
 * @phpstan-return array<string, array<string, mixed>>
 */
function analyze_seo_schema(): array {
  $schema['analyze_seo_scores'] = [
    'description' => 'Stores SEO scores per entity.',
    'fields' => [
      'entity_type' => [
        'type' => 'varchar',
        'length' => 128,
        'not null' => TRUE,
        'description' => 'The entity type ID.',
      ],
      'entity_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'The entity ID.',
      ],
      'bundle' => [
        'type' => 'varchar',
        'length' => 128,
        'not null' => TRUE,
        'default' => '',
        'description' => 'The entity bundle.',
      ],
      'content_hash' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'default' => '',
        'description' => 'SHA-256 hash of the rendered content.',
      ],
      'overall_score' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Overall SEO score (0-100).',
      ],
      'check_results' => [
        'type' => 'blob',
        'size' => 'big',
        'not null' => FALSE,
        'description' => 'JSON-encoded individual check results.',
      ],
      'last_checked' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Timestamp of the last analysis.',
      ],
    ],
    'primary key' => ['entity_type', 'entity_id'],
    'indexes' => [
      'bundle' => ['entity_type', 'bundle'],
      'score' => ['overall_score'],
      'last_checked' => ['last_checked'],
    ],
  ];

  return $schema;
}

/**
 * Implements hook_requirements().
 *
 * @phpstan-return array<string, array<string, mixed>>
 */
function analyze_seo_requirements(string $phase): array {
  $requirements = [];

  if ($phase === 'runtime') {
    $count = 0;
    if (\Drupal::database()->schema()->tableExists('analyze_seo_scores')) {
      $count = (int) \Drupal::database()
        ->select('analyze_seo_scores', 's')
        ->condition('overall_score', 50, '<')
        ->countQuery()
        ->execute()
        ->fetchField();
    }

    $total = 0;
    if (\Drupal::database()->schema()->tableExists('analyze_seo_scores')) {
      $total = (int) \Drupal::database()
        ->select('analyze_seo_scores', 's')
        ->countQuery()
        ->execute()
        ->fetchField();
    }

    $requirements['analyze_seo'] = [
      'title' => t('SEO Analysis'),
      'value' => t('@count of @total analysed pages score below 50%', [
        '@count' => $count,
        '@total' => $total,
      ]),
      'severity' => $count > 0 ? REQUIREMENT_WARNING : REQUIREMENT_OK,
    ];
  }

  return $requirements;
}

/**
 * Implements hook_uninstall().
 */
function analyze_seo_uninstall(): void {
  \Drupal::configFactory()->getEditable('views.view.seo_results')->delete();
  \Drupal::database()->schema()->dropTable('analyze_seo_scores');
}
